# Copia este archivo como .env (Copy-Item .env.example .env) y completa los valores.
# .env NUNCA se sube a Git.
#
# Para generar secretos aleatorios (JWT_SECRET, CI_RESULTS_TOKEN) en PowerShell:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

NODE_ENV=development
PORT=4000
# Zona horaria de la empresa: define a qué hora un sprint pasa a activo o finalizado
APP_TIMEZONE=America/Bogota

# MongoDB local (servicio de Windows). En la nube sería mongodb+srv://...
MONGODB_URI=mongodb://127.0.0.1:27017/qa_portal

# ---- Autenticación ----
# Secreto para firmar las sesiones. Mínimo 32 caracteres aleatorios. Cambiarlo cierra todas las sesiones.
JWT_SECRET=<genera-un-secreto-aleatorio>
JWT_EXPIRES_HOURS=8
# true cuando el portal se sirva por HTTPS
COOKIE_SECURE=false

# URL del frontend (CORS)
CORS_ORIGIN=http://localhost:5173

# ---- Ejecución de pruebas ----
# mock = simulado (desarrollo, no necesita GitLab) | gitlab = dispara el pipeline real
CI_PROVIDER=mock
GITLAB_API_URL=https://gitlab.com/api/v4
# ID numérico del proyecto qa-automation (GitLab: Settings > General)
GITLAB_PROJECT_ID=
# Settings > CI/CD > Pipeline trigger tokens (solo permite crear pipelines en ese proyecto)
GITLAB_TRIGGER_TOKEN=
GITLAB_REF=main

# Token compartido con el pipeline para enviar resultados (mismo valor que la variable
# PORTAL_CI_TOKEN en GitLab). Mínimo 32 caracteres aleatorios.
CI_RESULTS_TOKEN=<genera-un-secreto-aleatorio>

# ---- Solo para el script de datos de ejemplo (npm run seed) ----
SEED_ADMIN_EMAIL=admin@qa.local
SEED_ADMIN_NAME=Administrador QA
# Mínimo 12 caracteres. Es una cuenta local de desarrollo, no reutilices contraseñas reales.
SEED_ADMIN_PASSWORD=<elige-una-contraseña-de-desarrollo>
